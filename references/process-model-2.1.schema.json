{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arman.local/schemas/process-model-2.1.schema.json",
  "title": "ARMAN canonical BPMN process model 2.1",
  "type": "object",
  "required": ["schema_version", "process_id", "process_name", "process_type", "start", "steps", "gateways", "participants", "information_gaps"],
  "properties": {
    "schema_version": {"const": "2.1"},
    "process_id": {"type": "string", "minLength": 1},
    "process_name": {"type": "string", "minLength": 1},
    "process_type": {"enum": ["AS-IS", "TO-BE"]},
    "render_profile": {"enum": ["legacy_role_lanes_v1", "corporate_role_overlays_v2"]},
    "start": {"type": "string", "minLength": 1},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "gateways": {"type": "array", "items": {"$ref": "#/$defs/gateway"}},
    "participants": {"type": "array", "items": {"$ref": "#/$defs/participant"}},
    "message_flows": {"type": "array", "items": {"$ref": "#/$defs/messageFlow"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "information_gaps": {"type": "array", "items": {"$ref": "#/$defs/informationGap"}},
    "systems": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"}
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["source_file"],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "source_type": {"type": "string"},
        "section": {"type": "string"},
        "locator": {"type": "string"},
        "excerpt": {"type": "string"}
      },
      "additionalProperties": true
    },
    "businessObject": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["name", "kind"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "kind": {"enum": ["system_object", "system_report", "print_form", "external_document", "physical_object", "message", "other"]}
          },
          "additionalProperties": true
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["logical_object_id", "name", "state", "kind", "system", "bpmn_representation", "source_refs"],
      "properties": {
        "logical_object_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "state": {"type": ["string", "null"]},
        "kind": {"enum": ["system_object", "system_report", "print_form", "external_document", "physical_object", "message", "other"]},
        "metadata_type": {"type": ["string", "null"]},
        "system": {"type": ["string", "null"]},
        "bpmn_representation": {"enum": ["data_object", "data_store", "message", "physical"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "assessmentSide": {
      "type": "object",
      "required": ["status", "information_gap_ref"],
      "properties": {
        "status": {"enum": ["identified", "not_applicable", "open"]},
        "information_gap_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifactAssessment": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {"$ref": "#/$defs/assessmentSide"},
        "output": {"$ref": "#/$defs/assessmentSide"}
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["style_class", "fill_override", "source_refs"],
      "properties": {
        "style_class": {"type": ["string", "null"]},
        "fill_override": {"type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "parent_id", "name", "role", "performer_kind", "system", "action", "business_object", "task_type", "display_codes", "display_code_origin", "presentation", "inputs", "outputs", "artifact_assessment", "control", "condition", "exception_refs", "knowledge_status", "source_refs", "next", "basis", "observable_result", "verification_criterion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": ["string", "null"]},
        "performer_kind": {"enum": ["human", "automated", "process"]},
        "responsible_owner": {"type": ["string", "null"]},
        "system": {"type": "string"},
        "execution_channel": {"type": ["string", "null"]},
        "action": {"type": ["string", "null"]},
        "business_object": {"$ref": "#/$defs/businessObject"},
        "basis": {"type": ["string", "null"]},
        "observable_result": {"type": ["string", "null"]},
        "verification_criterion": {"type": ["string", "null"]},
        "pool_id": {"type": ["string", "null"]},
        "task_type": {"enum": ["start_event", "end_event", "intermediate_catch_event", "intermediate_throw_event", "user_task", "manual_task", "service_task", "script_task", "business_rule_task", "send_task", "receive_task", "call_activity", "subprocess"]},
        "event_definition": {"enum": ["none", "message", "timer", "conditional", "signal", "multiple", "parallel_multiple"]},
        "called_process_id": {"type": ["string", "null"]},
        "display_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "display_code_origin": {"enum": ["source", "generated"]},
        "presentation": {"$ref": "#/$defs/presentation"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "artifact_assessment": {"$ref": "#/$defs/artifactAssessment"},
        "control": {"type": "array", "items": {"type": "string"}},
        "condition": {"type": ["string", "null"]},
        "exception_refs": {"type": "array", "items": {"type": "string"}},
        "knowledge_status": {"enum": ["CONFIRMED", "PROJECT_RECOMMENDATION", "ASSUMPTION", "OPEN", "REQUIRES_1C_METADATA_VALIDATION"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}},
        "next": {"type": "array", "items": {"type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"task_type": {"const": "call_activity"}}, "required": ["task_type"]},
          "then": {
            "properties": {
              "called_process_id": {"type": "string", "minLength": 1},
              "performer_kind": {"const": "process"},
              "role": {"type": "null"}
            },
            "required": ["called_process_id"]
          }
        }
      ],
      "additionalProperties": true
    },
    "gateway": {
      "type": "object",
      "required": ["id", "name", "gateway_type", "gateway_role", "paired_gateway_id", "next", "branches", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "gateway_type": {"enum": ["xor", "or", "and", "event_based"]},
        "gateway_role": {"enum": ["split", "merge"]},
        "paired_gateway_id": {"type": ["string", "null"]},
        "next": {"type": "array", "items": {"type": "string"}},
        "branches": {"type": "array"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "participant": {
      "type": "object",
      "required": ["id", "name", "participant_kind", "black_box", "linked_process", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "participant_kind": {"enum": ["current_process", "external_process", "external_party"]},
        "black_box": {"type": "boolean"},
        "linked_process": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["id", "uri", "source_refs"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "uri": {"type": ["string", "null"]},
                "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
              },
              "additionalProperties": false
            }
          ]
        },
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "messageFlow": {
      "type": "object",
      "required": ["id", "source", "target", "name", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "annotation": {
      "type": "object",
      "required": ["id", "text", "attached_to", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "attached_to": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}
      },
      "additionalProperties": true
    },
    "informationGap": {
      "type": "object",
      "required": ["step_id", "missing_information", "diagram_impact", "customer_question", "status"],
      "properties": {
        "id": {"type": "string"},
        "step_id": {"type": "string"},
        "missing_information": {"type": "string"},
        "diagram_impact": {"type": "string"},
        "customer_question": {"type": "string"},
        "status": {"type": "string"},
        "severity": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
